backend:
  name: github
  repo: Natalia376540/внутренняя-тишина
  branch: main

media_folder: "images/uploads"
public_folder: "/images/uploads"

collections:
  - name: "content"
    label: "Контент"
    files:

      - label: "Статьи"
        name: "articles"
        file: "data.json"
        fields:
          - label: "Статьи"
            name: "articles"
            widget: "list"
            fields:

              - label: "ID"
                name: "id"
                widget: "string"

              - label: "Раздел"
                name: "section"
                widget: "select"
                options:
                  - "Женщина"
                  - "Мужчина"
                  - "Стиль"
                  - "Красота"
                  - "Дом"
                  - "Культура"
                  - "Деньги"
                  - "Эссе"
                  - "Бестиарии"
                  - "Книги"
                  - "Кулинария без проблем"

              - label: "Название статьи"
                name: "title"
                widget: "string"

              - label: "Короткое описание"
                name: "description"
                widget: "text"

              - label: "Текст статьи"
                name: "text"
                widget: "markdown"

              - label: "Фотография"
                name: "photo"
                widget: "image"
                required: false
